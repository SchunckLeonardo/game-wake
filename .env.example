# Discord (scripts locais; o configure-secrets grava bot/client secret no SSM)
DISCORD_APPLICATION_ID=000000000000000000
DISCORD_BOT_TOKEN=substitua-pelo-token-do-bot

# AWS/Terraform (a Console usa NEXT_PUBLIC_* no ambiente do host, nao neste arquivo)
AWS_PROFILE=default
AWS_REGION=us-east-1
TF_WORKSPACE=default

# Segredos dos provedores gravados no Parameter Store; nunca use placeholders em producao
DISCORD_CLIENT_SECRET=substitua-pelo-client-secret-do-oauth
ABACATEPAY_API_KEY=substitua-pela-chave-v2
ABACATEPAY_WEBHOOK_SECRET=substitua-pelo-segredo-da-url-do-webhook
# Chave HMAC publica documentada em https://docs.abacatepay.com/pages/webhooks/security
# Nao use aqui a chave publica curta exibida junto das credenciais da loja.
