# Discord (usado apenas pelos scripts locais; nunca faça commit de .env)
DISCORD_APPLICATION_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000
DISCORD_BOT_TOKEN=substitua-pelo-token-do-bot

# AWS/Terraform
AWS_PROFILE=default
AWS_REGION=us-east-1
TF_WORKSPACE=default

# Segredos gravados no Parameter Store por scripts/configure-secrets.sh
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
PALWORLD_SERVER_PASSWORD=substitua-por-uma-senha-forte
PALWORLD_ADMIN_PASSWORD=substitua-por-uma-senha-administrativa-forte
DISCORD_CLIENT_SECRET=substitua-pelo-client-secret-do-oauth
ABACATEPAY_API_KEY=substitua-pela-chave-v2
ABACATEPAY_WEBHOOK_SECRET=substitua-pelo-segredo-da-url-do-webhook
ABACATEPAY_PUBLIC_KEY=substitua-pela-chave-publica-hmac
